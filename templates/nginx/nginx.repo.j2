[nginx-{{ nginx_repo_branch }}]
name=nginx {{ nginx_repo_branch }} repo
baseurl=https://nginx.org/packages/{{ 'mainline/' if nginx_repo_branch == 'mainline' else '' }}centos/{{ ansible_distribution_major_version }}/{{ ansible_architecture }}/
gpgcheck=1
enabled=1
gpgkey=https://nginx.org/keys/nginx_signing.key
module_hotfixes=true
